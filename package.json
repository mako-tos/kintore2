{
  "name": "kintore2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run generate-types",
    "build": "next build",
    "build:netlify": "rm -rf ./node_modules &&npm install --omit=dev && npm run build",
    "build:contract": "tsc -p tsconfig.testbuild.json",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.development jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "contract-test": "npm run build && npm run build:contract && node dist/test/contract-tests.js",
    "generate-types": "node tools/generate-types.js",
    "dev": "dotenv -e .env.development next dev",
    "start": "dotenv -e .env.production next start",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@supabase/supabase-js": "^2.84.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "critters": "^0.0.25",
    "eslint": "^8.57.0",
    "json-schema-to-typescript": "^15.0.4",
    "next": "^16.0.3",
    "next-pwa": "^5.6.0",
    "purecss": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.2.0",
    "baseline-browser-mapping": "^2.8.32",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.5"
  }
}
